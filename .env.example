# Server-side origin; use HTTPS in production. NODE_ENV is managed by Next.js.
APP_URL=http://localhost:3000

# Required to access /dashboard. Inject both from an encrypted secret manager.
# The password must contain at least 16 characters. HTTP Basic requires HTTPS
# outside loopback development and is intentionally scoped to the dashboard.
# ADMIN_USERNAME=<PRIVATE_ADMIN_USERNAME>
# ADMIN_PASSWORD=<RANDOM_ADMIN_PASSWORD_AT_LEAST_16_CHARACTERS>
# Server Actions additionally require a same-origin Origin/Host pair. APP_URL
# must match the externally visible HTTPS origin outside loopback development.

# Meta integration is DEVELOPMENT ONLY. Production must keep this disabled.
INSTAGRAM_INTEGRATION_MODE=disabled
# Enables only the bounded server-side dashboard GET client. This does not
# enable webhook challenge/ingestion, subscriptions, delivery or generic Graph.
INSTAGRAM_ADMIN_READ_MODE=disabled
# Only reviewed versions are allowed: v26.0, v27.0.
INSTAGRAM_API_VERSION=v27.0
# Only Unified Login is supported. Tokens use graph.facebook.com.
INSTAGRAM_AUTH_MODEL=unified_login

# Inject real secrets from an encrypted secret manager into the server environment.
# Do not save real credentials in plaintext project files or commit values.
# META_WEBHOOK_APP_SECRET=<APP_SETTINGS_BASIC_SECRET_FOR_WEBHOOK_SIGNATURES>
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=<RANDOM_32_BYTE_HEX_VALUE>
# INSTAGRAM_ACCOUNT_ID=<AUTHORIZED_PROFESSIONAL_ACCOUNT_USER_ID>

# Optional read-only verification: Business Integration System User token (SUAT).
# Obtain through Unified Login Generate token, not legacy Instagram Login.
# No token is needed for isolated webhook tests. No automatic API calls are made.
# META_SYSTEM_USER_ACCESS_TOKEN=<BUSINESS_INTEGRATION_SYSTEM_USER_ACCESS_TOKEN>
# META_LOGIN_CONFIG_ID=<FACEBOOK_LOGIN_FOR_BUSINESS_CONFIGURATION_ID>
# META_CLIENT_BUSINESS_ID=<CLIENT_BUSINESS_PORTFOLIO_ID>
# Both metadata IDs are required when the SUAT variable is supplied.
# Remove the old INSTAGRAM_ACCESS_TOKEN variable; never rename/reuse its value.

# OAuth initiation and credential persistence are not implemented.

# Inject DATABASE_URL and EVENT_ENCRYPTION_KEY for enabled ingestion.
# DATABASE_URL=<POSTGRESQL_CONNECTION_URL>
# DIRECT_DATABASE_URL=<DIRECT_POSTGRESQL_URL_FOR_MIGRATIONS_ONLY>
# EVENT_ENCRYPTION_KEY=<64_HEX_CHARACTERS_FROM_32_RANDOM_BYTES>
# Tests NEVER fall back to DATABASE_URL. Use a separate local database ending _test.
# TEST_DATABASE_URL=<ISOLATED_LOCAL_POSTGRESQL_TEST_URL>

# Jobs are local-development only. Keep the Inngest endpoint out of public tunnels.
JOBS_MODE=disabled
# INNGEST_DEV=1

# Local Docker PostgreSQL host port.
POSTGRES_PORT=5433

# Sending stays disabled; mock is restricted to an isolated local _test database.
INSTAGRAM_DELIVERY_MODE=disabled
INSTAGRAM_PUBLIC_FALLBACK_ENABLED=0
# Do not enable controlled_test before a separately approved one-comment live test.
# INSTAGRAM_DELIVERY_EXECUTION_ID=<EXACT_CANONICAL_EXECUTION_UUID>
# INSTAGRAM_DELIVERY_ACCOUNT_ID=<VERIFIED_PROFESSIONAL_ACCOUNT_ID>
# INSTAGRAM_DELIVERY_COMMENT_ID=<AUTHORIZED_TEST_COMMENT_ID>
# INSTAGRAM_DELIVERY_MEDIA_ID=<AUTHORIZED_TEST_PUBLICATION_ID>
# INSTAGRAM_DELIVERY_APPROVAL_ID=<OPERATOR_APPROVAL_UUID>
# INSTAGRAM_DELIVERY_PREPARATION_SHA256=<SHA256_OF_EXISTING_PRIVATE_PREPARATION_FILE>
# INSTAGRAM_DELIVERY_APPROVED_UNTIL=<UTC_ISO_TIMESTAMP_WITHIN_15_MINUTES>
# INSTAGRAM_DELIVERY_CREDENTIALS_VERIFIED=1
# INSTAGRAM_DELIVERY_PERMISSIONS_VERIFIED=1
# These flags are operator attestations, not evidence of Meta grants.

# Development observation and matching require explicit approval; no sending.
# INSTAGRAM_WEBHOOK_TEST_APPROVAL=1
# INNGEST_SDK_URL=http://127.0.0.1:3145/api/inngest
